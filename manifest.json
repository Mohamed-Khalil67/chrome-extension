{
  "manifest_version": 3,
  "name": "FE Lens",
  "short_name": "FE Lens",
  "description": "Click any area of your front-end app to see the component, file, styles, HTTP calls and errors behind it. Angular first.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open FE Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabs", "storage", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "http://*.localhost/*",
    "http://*.test/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": ["content/hook.main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": ["content/css-inspect.js", "content/picker.js", "content/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Pick an element on the page"
    }
  }
}
