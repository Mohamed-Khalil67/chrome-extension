{
  "manifest_version": 3,
  "name": "Angular Lens",
  "short_name": "Angular Lens",
  "description": "Inspect Angular components, templates, styles, network calls and console, and test HTTP requests with generated TypeScript interfaces.",
  "version": "0.6.0",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Angular Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "http://*.localhost/*",
    "http://*.test/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": [
        "content/hook.main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": [
        "content/isolated.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Pick an element on the page"
    }
  }
}
